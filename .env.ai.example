# Core
POSTGRES_DB=nexora
POSTGRES_USER=nexora
POSTGRES_PASSWORD=nexora-change-me
DATABASE_URL=postgresql+psycopg://nexora:nexora-change-me@postgres:5432/nexora
ENABLE_MQTT=true
MQTT_HOST=broker-nexora.kumalabs.tech
MQTT_PORT=1883
MQTT_USERNAME=nexora
MQTT_PASSWORD=CHANGE_ME
MQTT_TOPIC_PATTERN=energy/+/+/consumption
# Optional: specific topics (comma-separated) if broker ACL blocks wildcard.
# If set, backend will subscribe to these topics and ignore MQTT_TOPIC_PATTERN.
# Example:
# MQTT_TOPICS=energy/C01/U01/consumption,energy/C01/U02/consumption,energy/C01/U03/consumption
MQTT_TOPICS=
APP_PORT=8100

# External AI orchestration
AI_ENABLED=true
AI_BASE_URL=http://ai-nexora.kumalabs.tech
AI_TIMEOUT_SECONDS=8
AI_RETRY_COUNT=2
AI_SCHEDULER_INTERVAL_SECONDS=3600
